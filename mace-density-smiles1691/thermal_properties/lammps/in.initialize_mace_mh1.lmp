echo both
units metal
atom_style full
atom_modify map yes
newton on
boundary p p p

variable thermal_input_data getenv THERMAL_INPUT_DATA
variable thermal_initialize_resume getenv THERMAL_INITIALIZE_RESUME
variable thermal_predecessor_restart getenv THERMAL_PREDECESSOR_RESTART
variable thermal_dt_ps getenv THERMAL_DT_PS
variable thermal_initial_temp_k getenv THERMAL_INITIAL_TEMP_K
variable thermal_tdamp_ps getenv THERMAL_TDAMP_PS
variable thermal_seed getenv THERMAL_SEED
variable thermal_minimize getenv THERMAL_MINIMIZE
variable thermal_min_etol getenv THERMAL_MIN_ETOL
variable thermal_min_ftol getenv THERMAL_MIN_FTOL
variable thermal_min_maxiter getenv THERMAL_MIN_MAXITER
variable thermal_min_maxeval getenv THERMAL_MIN_MAXEVAL
variable thermal_initial_nvt_steps getenv THERMAL_INITIAL_NVT_STEPS
variable thermal_thermo_every_steps getenv THERMAL_THERMO_EVERY_STEPS
variable thermal_sample_every_steps getenv THERMAL_SAMPLE_EVERY_STEPS
variable thermal_restart_every_steps getenv THERMAL_RESTART_EVERY_STEPS
variable thermal_initialize_csv getenv THERMAL_INITIALIZE_CSV
variable thermal_initialize_restart_root getenv THERMAL_INITIALIZE_RESTART_ROOT
variable thermal_lammps_log getenv THERMAL_LAMMPS_LOG

# LAMMPS suppresses $ substitution inside parser-level quotes.  Runtime paths
# are therefore expanded unquoted and must not contain whitespace.
log ${thermal_lammps_log}
print "THERMAL_PHASE=initialize"
print "THERMAL_INITIALIZE_RESUME=${thermal_initialize_resume}"
print "THERMAL_INPUT_DATA=${thermal_input_data}"
print "THERMAL_PREDECESSOR_RESTART=${thermal_predecessor_restart}"
print "THERMAL_INITIAL_TEMP_K=${thermal_initial_temp_k}"
print "THERMAL_DT_PS=${thermal_dt_ps}"

# Keep file-reading commands out of `if` action strings.  LAMMPS parses those
# strings a second time and can otherwise preserve the path variable literally.
if "${thermal_initialize_resume} == yes" then &
  "jump SELF thermal_initialize_from_checkpoint"

print "THERMAL_INITIALIZE_SOURCE=input_data"
read_data ${thermal_input_data} nocoeff
jump SELF thermal_initialize_source_loaded

label thermal_initialize_from_checkpoint
print "THERMAL_INITIALIZE_SOURCE=checkpoint"
read_restart ${thermal_predecessor_restart}

label thermal_initialize_source_loaded

include mace_mh1_thermal_setup.mod
include thermal_temperature.mod

timestep ${thermal_dt_ps}

thermo ${thermal_thermo_every_steps}
thermo_style custom step time temp press density vol pe ke etotal enthalpy pxx pyy pzz pxy pxz pyz lx ly lz c_thermal_force_max
thermo_modify temp thermal_temperature press thermal_pressure flush yes lost error norm no

if "${thermal_initialize_resume} == no" then &
  "print 'THERMAL_INITIALIZE_SEGMENT=run0_raw'" &
  "run 0"

if "${thermal_initialize_resume} == no && ${thermal_minimize} == yes" then &
  "print 'THERMAL_INITIALIZE_SEGMENT=minimize_fixed_box'" &
  "min_style fire" &
  "minimize ${thermal_min_etol} ${thermal_min_ftol} ${thermal_min_maxiter} ${thermal_min_maxeval}"

# This is the only thermal-property input that may create velocities, and only
# on the first initialization attempt for a replica.  A resumed checkpoint
# retains the original trajectory's velocities and timestep.
if "${thermal_initialize_resume} == no" then &
  "reset_timestep 0" &
  "velocity all create ${thermal_initial_temp_k} ${thermal_seed} mom yes rot yes dist gaussian"

fix thermal_initialize_nvt all nvt temp ${thermal_initial_temp_k} ${thermal_initial_temp_k} ${thermal_tdamp_ps}
fix_modify thermal_initialize_nvt temp thermal_temperature

fix thermal_initialize_csv all print ${thermal_sample_every_steps} &
  "${thermal_csv_step},${thermal_csv_time_ps},${thermal_csv_temp_k},${thermal_csv_press_bar},${thermal_csv_density_g_cm3},${thermal_csv_volume_a3},${thermal_csv_pe_ev},${thermal_csv_ke_ev},${thermal_csv_etotal_ev},${thermal_csv_enthalpy_ev},${thermal_csv_pxx_bar},${thermal_csv_pyy_bar},${thermal_csv_pzz_bar},${thermal_csv_pxy_bar},${thermal_csv_pxz_bar},${thermal_csv_pyz_bar},${thermal_csv_lx_a},${thermal_csv_ly_a},${thermal_csv_lz_a},${thermal_csv_fmax_ev_a},${thermal_csv_atom_count}" &
  file ${thermal_initialize_csv} screen no &
  title "step,time_ps,temp_K,press_bar,density_g_cm3,volume_A3,pe_eV,ke_eV,etotal_eV,enthalpy_eV,pxx_bar,pyy_bar,pzz_bar,pxy_bar,pxz_bar,pyz_bar,lx_A,ly_A,lz_A,fmax_eV_A,atom_count"

if "${thermal_restart_every_steps} > 0" then &
  "restart ${thermal_restart_every_steps} ${thermal_initialize_restart_root}"

print "THERMAL_INITIALIZE_SEGMENT=nvt"
run ${thermal_initial_nvt_steps}

restart 0
unfix thermal_initialize_csv
unfix thermal_initialize_nvt

print "THERMAL_INITIALIZE_COMPLETE=yes"
